{
  "name": "incarnamind",
  "productName": "IncarnaMind",
  "version": "0.1.0-alpha.4",
  "private": true,
  "description": "A local-first notebook that answers Questions from your own Documents.",
  "license": "Apache-2.0",
  "author": "Junru Xiong",
  "homepage": "https://github.com/IncarnaMind/IncarnaMind",
  "main": "./out/main/index.js",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:smoke": "electron-vite build --mode test && playwright test",
    "test:packaged": "playwright test -c e2e/packaged/playwright.packaged.config.ts",
    "demo:record": "playwright test -c e2e/demo/playwright.demo.config.ts readmeDemo",
    "eval": "vitest run --config eval/vitest.config.ts",
    "eval:classification": "vitest run --config eval/classification/vitest.config.ts",
    "eval:organize": "vitest run --config eval/organize/vitest.config.ts",
    "eval:hard": "vitest run --config eval/hard/vitest.config.ts",
    "eval:word": "vitest run --config eval/word/vitest.config.ts",
    "eval:excel": "vitest run --config eval/excel/vitest.config.ts",
    "eval:everyday": "vitest run --config eval/everyday/vitest.config.ts",
    "eval:minds": "vitest run --config eval/minds/vitest.config.ts",
    "eval:reports": "vitest run --config eval/reports/vitest.config.ts",
    "eval:repeats": "vitest run --config eval/repeats/vitest.config.ts",
    "eval:scope": "vitest run --config eval/repeats/vitest.scope.config.ts",
    "eval:whole-read": "vitest run --config eval/repeats/vitest.wholeRead.config.ts",
    "eval:claims": "vitest run --config eval/repeats/vitest.claims.config.ts",
    "eval:support": "vitest run --config eval/answerSupport/vitest.config.ts",
    "eval:harness": "vitest run --config eval/harness/vitest.config.ts",
    "eval:speed": "vitest run --config eval/speed/vitest.config.ts",
    "eval:speed:tokens": "INCARNAMIND_EVAL_SPEED_AUDIT=1 vitest run --config eval/speed/vitest.config.ts",
    "eval:word:fetch": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON eval/word/fetch-extended.ts",
    "eval:dump": "vitest run --config eval/dumps/vitest.config.ts",
    "eval:references": "vitest run --config eval/references/vitest.config.ts",
    "eval:ocr": "vitest run --config eval/ocr/vitest.config.ts",
    "eval:transcription": "vitest run --config eval/transcription/vitest.config.ts",
    "eval:meetings": "vitest run --config eval/meetings/vitest.config.ts",
    "eval:meetings:fetch": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./scripts/tsResolve.mjs eval/meetings/fetch.ts",
    "eval:meetings:score": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./scripts/tsResolve.mjs eval/meetings/score.ts",
    "eval:meetings:words": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./scripts/tsResolve.mjs eval/meetings/pickWords.ts",
    "eval:speakers": "vitest run --config eval/speakers/vitest.config.ts",
    "eval:score": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON eval/score.ts",
    "nightly:real-model": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./scripts/tsResolve.mjs scripts/nightlyRealModel.ts",
    "catalog:update": "node --import ./scripts/tsResolve.mjs scripts/catalogModels.ts",
    "styles:pack": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./scripts/tsResolve.mjs scripts/citationStylePack.ts",
    "dist": "electron-vite build && electron-builder --publish never",
    "dist:dir": "electron-vite build && electron-builder --dir --publish never",
    "check:package": "node scripts/check-package.mjs",
    "icons": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/icons.ts",
    "samples:generate": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./scripts/tsResolve.mjs scripts/sampleDocuments/index.ts",
    "examples:credit:print": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./scripts/tsResolve.mjs scripts/exampleDocuments/index.ts",
    "eval:skills": "vitest run --config eval/skills/vitest.config.ts",
    "eval:citations": "vitest run --config eval/citations/vitest.config.ts run.citations",
    "eval:citations:estimate": "vitest run --config eval/citations/vitest.config.ts estimate.citations",
    "eval:citations:judge": "vitest run --config eval/citations/vitest.config.ts judge.citations",
    "eval:citations:score": "vitest run --config eval/citations/vitest.config.ts score.citations",
    "eval:citations:scan": "vitest run --config eval/citations/vitest.config.ts scan.citations"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "2.0.2",
    "@ai-sdk/alibaba": "2.0.65",
    "@ai-sdk/anthropic": "4.0.78",
    "@ai-sdk/cohere": "4.0.59",
    "@ai-sdk/deepseek": "3.0.63",
    "@ai-sdk/google": "4.0.93",
    "@ai-sdk/mistral": "4.0.62",
    "@ai-sdk/moonshotai": "3.0.67",
    "@ai-sdk/openai": "4.0.91",
    "@ai-sdk/openai-compatible": "3.0.67",
    "@ai-sdk/voyage": "2.0.58",
    "@ai-sdk/xai": "5.0.20",
    "@ai-sdk/zai": "3.0.29",
    "@anthropic-ai/sandbox-runtime": "0.0.79",
    "@floating-ui/dom": "1.8.0",
    "@huggingface/tokenizers": "0.2.0",
    "@modelcontextprotocol/sdk": "1.32.1",
    "@modelcontextprotocol/server": "2.3.1",
    "@mozilla/readability": "0.6.0",
    "@napi-rs/canvas": "1.0.10",
    "@openrouter/ai-sdk-provider": "3.1.0",
    "@tiptap/core": "3.31.4",
    "@tiptap/extension-code-block": "3.31.4",
    "@tiptap/extension-code-block-lowlight": "3.31.4",
    "@tiptap/extension-collaboration": "3.31.4",
    "@tiptap/extension-drag-handle": "3.31.4",
    "@tiptap/extension-drag-handle-react": "3.31.4",
    "@tiptap/extension-highlight": "3.31.4",
    "@tiptap/extension-list": "3.31.4",
    "@tiptap/extension-mathematics": "3.31.4",
    "@tiptap/extension-node-range": "3.31.4",
    "@tiptap/extension-table": "3.31.4",
    "@tiptap/extension-typography": "3.31.4",
    "@tiptap/extension-unique-id": "3.31.4",
    "@tiptap/extensions": "3.31.4",
    "@tiptap/pm": "3.31.4",
    "@tiptap/react": "3.31.4",
    "@tiptap/starter-kit": "3.31.4",
    "@tiptap/suggestion": "3.31.4",
    "@tiptap/y-tiptap": "3.0.9",
    "@xmldom/xmldom": "0.9.12",
    "ai": "7.0.129",
    "ajv": "8.20.0",
    "cross-spawn": "7.0.6",
    "docx-preview": "0.4.1",
    "electron-updater": "6.8.10",
    "highlight.js": "11.12.0",
    "ipaddr.js": "2.5.0",
    "katex": "0.18.10",
    "linkedom": "0.18.13",
    "lowlight": "3.3.0",
    "motion": "14.1.0",
    "ollama-ai-provider-v2": "4.0.1",
    "onnxruntime-node": "1.30.0",
    "opencc-js": "1.4.2",
    "pdfjs-dist": "6.4.299",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "semver": "7.8.5",
    "sherpa-onnx-node": "1.13.8",
    "undici": "7.30.1",
    "y-protocols": "1.0.7",
    "yjs": "13.6.33",
    "zod": "4.6.6",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@electron/asar": "3.4.1",
    "@fontsource-variable/source-serif-4": "5.3.0",
    "@fontsource/caladea": "5.3.0",
    "@fontsource/carlito": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "@modelcontextprotocol/client": "2.3.1",
    "@playwright/test": "1.63.0",
    "@sentry/electron": "8.1.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "24.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/semver": "7.8.0",
    "@vitejs/plugin-react": "5.2.0",
    "electron": "44.9.1",
    "electron-builder": "26.17.0",
    "electron-vite": "5.0.0",
    "html-validate": "11.16.2",
    "hyparquet": "1.31.5",
    "hyparquet-compressors": "1.1.2",
    "opencc-data": "1.4.2",
    "posthog-node": "5.54.1",
    "pyodide": "314.0.7",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "7.3.7",
    "vitest": "5.0.3"
  },
  "allowScripts": {
    "esbuild": true,
    "onnxruntime-node": true,
    "electron-winstaller": false,
    "fsevents": false
  }
}
