<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
  <dict>
    <!-- electron-builder's defaults, which Electron needs under the hardened runtime. -->
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
    <!-- Meetings (ADR-0015): without it, a hardened-runtime build can't open the microphone. -->
    <key>com.apple.security.device.audio-input</key>
    <true/>
    <!-- Meetings coming up (#190): the Mac's calendars, read by the calendar helper. -->
    <key>com.apple.security.personal-information.calendars</key>
    <true/>
  </dict>
</plist>
