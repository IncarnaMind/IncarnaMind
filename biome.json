{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "src/**",
      "tests/**",
      "e2e/**",
      "eval/**/*.ts",
      "*.ts",
      "*.json",
      "!**/package-lock.json",
      "!tests/fixtures/web",
      "!tests/fixtures/formats/*.html",
      "!tests/fixtures/organize-fresh"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "a11y": {
        "noLabelWithoutControl": {
          "level": "error",
          "options": { "inputComponents": ["TypingTextarea"] }
        }
      }
    }
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "overrides": [
    {
      "includes": ["src/**", "!src/renderer/src/motion.ts"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "motion": "Animate through src/renderer/src/motion.ts: its tokens, helpers and reduced motion (DESIGN.md, Motion).",
                  "motion/mini": "Animate through src/renderer/src/motion.ts: its tokens, helpers and reduced motion (DESIGN.md, Motion).",
                  "motion/react": "Animate through src/renderer/src/motion.ts: its tokens, helpers and reduced motion (DESIGN.md, Motion).",
                  "framer-motion": "Animate through src/renderer/src/motion.ts: its tokens, helpers and reduced motion (DESIGN.md, Motion).",
                  "motion-dom": "Animate through src/renderer/src/motion.ts: its tokens, helpers and reduced motion (DESIGN.md, Motion)."
                }
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/renderer/**", "!src/renderer/src/components/TypingTextarea.tsx"],
      "linter": {
        "rules": {
          "correctness": {
            "noRestrictedElements": {
              "level": "error",
              "options": {
                "elements": {
                  "textarea": "Use TypingTextarea (components/TypingTextarea.tsx): a plain controlled <textarea> makes Undo take typing back one character at a time."
                }
              }
            }
          }
        }
      }
    },
    {
      "includes": [
        "src/renderer/**",
        "!src/renderer/print/**",
        "!src/renderer/src/fonts.css",
        "!src/renderer/src/viewer/officeFonts.css",
        "!src/renderer/src/viewer/slides/SlideCanvas.tsx",
        "!src/renderer/src/viewer/slides/ChartView.tsx",
        "!src/renderer/src/editor/ChartPlot.tsx"
      ],
      "plugins": ["./biome/noRawFontSizeCss.grit", "./biome/noRawFontSizeJs.grit"]
    },
    {
      "includes": ["src/renderer/**", "!src/renderer/src/components/icons.tsx"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "lucide-react": "Import icons from components/icons.tsx: one set, one line width, two sizes (DESIGN.md, Icons; #3766)."
                }
              }
            }
          }
        }
      }
    },
    {
      "includes": [
        "src/renderer/**",
        "!src/renderer/src/components/icons.tsx",
        "!src/renderer/src/components/providers/ProviderLogo.tsx",
        "!src/renderer/src/components/providers/ChatGptMark.tsx",
        "!src/renderer/src/viewer/slides/SlideCanvas.tsx",
        "!src/renderer/src/viewer/slides/ChartView.tsx",
        "!src/renderer/src/editor/ChartPlot.tsx",
        "!src/renderer/src/editor/citationScan.tsx",
        "!src/renderer/src/components/TypingTextarea.tsx"
      ],
      "linter": {
        "rules": {
          "correctness": {
            "noRestrictedElements": {
              "level": "error",
              "options": {
                "elements": {
                  "textarea": "Use TypingTextarea (components/TypingTextarea.tsx): a plain controlled <textarea> makes Undo take typing back one character at a time.",
                  "svg": "Use an icon from components/icons.tsx: one set, one line width, two sizes (DESIGN.md, Icons; #3766). A drawing of a Document's own (a chart, a slide, a scan) lives in its drawing file."
                }
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/core/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "electron": "The core must not depend on Electron (ADR-0004, ADR-0006). Pass the capability in as an adapter instead."
                }
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/main/**", "!src/main/engineProcess.ts"],
      "plugins": ["./biome/noUtilityProcess.grit"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "electron": {
                    "importNames": ["utilityProcess"],
                    "message": "Start an engine process with startEngineProcess (src/main/engineProcess.ts): it turns off ONNX Runtime's usage telemetry (#2145)."
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/shared/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "electron": "src/shared is pure: the core, the renderer and the workers all use it. Pass the capability in from the caller."
                },
                "patterns": [
                  {
                    "group": ["node:*"],
                    "message": "src/shared is pure: the core, the renderer and the workers all use it. Pass what needs Node in from the caller."
                  }
                ]
              }
            }
          }
        }
      }
    }
  ]
}
