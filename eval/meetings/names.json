      "lines": [
        {
          "side": "me",
          "text": "Hi Daniel, I'm Maren Okafor from the Larkfield orchard. Today we need to settle the cider press and the festival stall."
        },
        {
          "side": "them",
          "text": "Thanks, Maren. The supplier's quote for the press came in at forty-two thousand five hundred pounds, installed."
        },
        {
          "side": "me",
          "text": "That fits our budget. Let's buy the press for forty-two thousand five hundred pounds, installed by the twelfth of March."
        },
        {
          "side": "them",
          "text": "Agreed. Last season we pressed eighteen hundred litres, so the new press doubles that."
        },
        {
          "side": "me",
          "text": "I'll send the signed purchase order to the supplier by Friday."
        },
        {
          "side": "them",
          "text": "Ilse Brannock will book the electrician by the twentieth of November."
        },
        {
          "side": "me",
          "text": "Good. For the festival stall, Teodor Vasquez drafts the stall budget by the first of December."
        },
        {
          "side": "them",
          "text": "One question is still open: who pays for delivery of the press?"
        },
        {
          "side": "me",
          "text": "Let's leave that open until the supplier answers. Thanks, Daniel."
        }
      ]
